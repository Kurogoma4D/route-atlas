# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Session encryption secret (use a strong random string in production)
SESSION_SECRET=your_session_secret

# OAuth callback URL (must match GitHub OAuth App settings)
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Frontend origin for CORS (used in development; in production, frontend is served from the same origin)
FRONTEND_ORIGIN=http://localhost:4200

# Allowed origins for CORS (comma-separated, used in production)
ALLOWED_ORIGINS=http://localhost:3000

# Cookie secure flag (auto-detected from OAUTH_CALLBACK_URL protocol if omitted)
# Set to "true" when serving over HTTPS, "false" for local HTTP
# COOKIE_SECURE=false

# Server port
PORT=3000

# Node environment (development | production)
NODE_ENV=development
